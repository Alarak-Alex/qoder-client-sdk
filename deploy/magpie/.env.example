# The page's key: 16 or more of a-z A-Z 0-9 - . _ ~
# `openssl rand -hex 16` makes one. Without it the link changes every restart.
MAGPIE_WEB_KEY=

# The host ports. The gateway's default 3425 is also a desktop magpie's, so
# a machine running both gives this one another port.
MAGPIE_PORT=3425
MAGPIE_WEB_PORT=3430

# The address other machines use for the gateway. The container only sees
# Docker's own 172.17.x, so this is the host's address and published port.
MAGPIE_PUBLIC_URL=http://192.168.0.60:3425

# Optional: only these addresses reach the gateway and the page (IP or CIDR,
# comma separated). Everything else gets 403 before its key is looked at.
MAGPIE_ALLOW_IPS=
